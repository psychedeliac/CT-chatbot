# Copy to .env and fill in. Only the API key is required — everything else
# falls back to the defaults in config.py.

# ── Required: LLM API key ─────────────────────────────────────────────────────
# Needed for the provider you use below. Gemini is the default.
GEMINI_API_KEY=
# GROQ_API_KEY=

# ── LLM ───────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=gemini                 # gemini | groq
# LLM_MODEL=gemini-flash-latest       # pinned versions get retired; prefer the alias
# LLM_TEMPERATURE=0.0

# ── Embeddings ────────────────────────────────────────────────────────────────
# huggingface runs locally and needs no key; google uses GEMINI_API_KEY.
# EMBEDDING_PROVIDER=huggingface      # huggingface | google
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Vector store ──────────────────────────────────────────────────────────────
# VECTOR_STORE_BACKEND=chroma
# CHROMA_PERSIST_DIR=./chroma_db
# RAG_COLLECTION=enriched_knowledge_base

# ── Retrieval tuning ──────────────────────────────────────────────────────────
# Values below mirror config.py. The two rerank thresholds are CALIBRATED, not
# taste: they were swept against data/eval_retrieval_set.json (61 queries), and
# config.py records why each landed where it did. Changing them by hand
# de-tunes the abstain gate -- the thing that stops off-topic queries getting
# debt content back. Re-run the sweep instead:
#   python scripts/eval_retrieval.py --threshold-sweep -12 8 1
# RAG_K=5
# RAG_CANDIDATE_POOL_K=15
# RRF_C=60
# RERANK_ENABLED=true
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_SCORE_THRESHOLD=2.0
# RERANK_RESCUE_SCORE_THRESHOLD=-9.0
# RERANK_RESCUE_RRF_RANK_CUTOFF=3

# ── PII guardrails ────────────────────────────────────────────────────────────
# Requires the spaCy model, or startup fails:
#   pip install https://github.com/explosion/spacy-models/releases/download/en_core_web_lg-3.8.0/en_core_web_lg-3.8.0-py3-none-any.whl
# PII_ENABLED=true
# PII_STRATEGY=anonymize      # anonymize | block  (no other value is valid)
